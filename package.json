{
  "name": "the-daily.studio",
  "version": "1.7.0",
  "description": "The Daily · Songs — a songwriter's workspace in one web page: clean canvas or start from a song, lyrics and chords, guitar + vocal recording, stem separation and a pedal rig. Local-first, no account.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TehauD/the-daily.studio.git"
  },
  "homepage": "https://the-daily.studio/",
  "bugs": {
    "url": "https://github.com/TehauD/the-daily.studio/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
    "start": "node scripts/serve.mjs",
    "test": "node test/smoke.cjs",
    "test:e2e": "node test/e2e.cjs",
    "test:stems": "node test/stem_eval.cjs",
    "test:mobile": "node test/mobile.cjs"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "playwright": "^1.50.0"
  },
  "author": {
    "name": "Tehau DeBarthe",
    "url": "https://github.com/TehauD"
  }
}
