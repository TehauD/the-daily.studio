{
  "name": "the-daily.studio",
  "version": "2.19.1",
  "description": "the-daily.studio — a guitar and voice studio in one web page: record guitar and mic, split any song into stems, get chords, tab and lyrics, with a pedal rig, presets and live visuals. Local-first, no account.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TehauD/the-daily.studio.git"
  },
  "homepage": "https://the-daily.studio/",
  "bugs": {
    "url": "https://github.com/TehauD/the-daily.studio/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
    "build:site": "node scripts/assemble.mjs",
    "verify:site": "node scripts/verify-site.mjs && node scripts/audit.mjs",
    "audit": "node scripts/audit.mjs",
    "start": "node scripts/serve.mjs",
    "test": "node test/smoke.cjs",
    "test:e2e": "node test/run.cjs",
    "test:stems": "node test/stem_eval.cjs",
    "test:mobile": "node test/mobile.cjs",
    "test:xbrowser": "node test/xbrowser.cjs",
    "test:e2e:core": "node test/e2e.cjs",
    "test:all": "npm test && node test/run.cjs",
    "shots": "node test/shots.cjs"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "playwright": "^1.50.0"
  },
  "author": {
    "name": "Tehau DeBarthe",
    "url": "https://github.com/TehauD"
  }
}
