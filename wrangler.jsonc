{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-daily-studio",
  "compatibility_date": "2026-10-01",
  // 2.53.1: the site is only at its own addresses, behind the domain's Cloudflare settings: no second copy at a workers.dev address, and
  // no preview addresses for each version.
  "workers_dev": false,
  "preview_urls": false,
  // Runs on every `wrangler deploy`, so the dist/ folder always exists even if the dashboard build command is wrong.
  "build": { "command": "npm run build:site && npm run verify:site" },
  // The Worker (worker/index.mjs) answers Sign in with GitHub's two routes (docs/GITHUB.md) and The Daily's own address (2.50).
  // Everything else is served from dist/ as before. Its secrets: npx wrangler secret put GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET.
  "main": "worker/index.mjs",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // The Worker runs only where it has work to do (2.52): The Daily's address (its "/" and "/move/"), the moving page at /journal/, Sign in
    // with GitHub, and backstage (kept off The Daily's address). Everything else, fonts, code, icons, pictures and the guide, is served as
    // static assets, which Cloudflare does not count as Worker requests. One visit to the studio is one Worker request.
    "run_worker_first": ["/", "/index.html", "/move", "/move/", "/journal", "/journal/*", "/auth/*", "/share/*", "/backstage", "/backstage/*"]
  },
  // The site and The Daily's own address. Both are attached on deploy when the domain's DNS is on Cloudflare (docs/HOSTING.md).
  "routes": [
    { "pattern": "the-daily.studio", "custom_domain": true },
    { "pattern": "journal.the-daily.studio", "custom_domain": true }
  ]
}
